{
  "name": "local-llm",
  "productName": "Local-LLM",
  "version": "1.3.3",
  "description": "Local LLM extension available wirelessly on macOS",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "cli": "node agents.js",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "test": "echo \"Error: no test specified\" && exit 1",
    "daemon": "node server-daemon.js"
  },
  "build": {
    "appId": "com.local.llm",
    "productName": "Local-LLM",
    "artifactName": "${productName}-${version}.${ext}",
    "directories": {
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "ui/assets/icon.png"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "ui/assets/icon.png"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "skills/**/*",
      "ui/**/*",
      "package.json",
      "!**/.env*",
      "!**/*.user-config.json",
      "!dist"
    ]
  },
  "keywords": [
    "llm",
    "ollama",
    "tailscale",
    "electron",
    "agent"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "chalk": "^5.6.2",
    "dotenv": "^18.0.9"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.0.20"
  }
}
