{
  "name": "local-wireless-llm",
  "productName": "Wireless LLM",
  "version": "1.0.0",
  "description": "An extension of your Local LLM now available everywhere",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "cli": "node agents.js",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "build": {
    "appId": "com.localwireless.llm",
    "productName": "Wireless LLM",
    "directories": {
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": ["dmg", "zip"],
      "icon": "ui/assets/icon.png"
    },
    "win": {
      "target": ["nsis", "portable"],
      "icon": "ui/assets/icon.png"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "skills/**/*",
      "ui/**/*",
      "package.json"
    ]
  },
  "keywords": [
    "llm",
    "ollama",
    "tailscale",
    "electron",
    "agent"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "chalk": "^5.6.2",
    "dotenv": "^18.0.9"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.0.20"
  }
}
